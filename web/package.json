{
  "name": "gosidian-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "gosidian v2.0 SPA — Vue 3 + Tailwind + CodeMirror 6",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build --outDir ../internal/server/web/dist --emptyOutDir",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write \"src/**/*.{ts,vue,css,json}\""
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.7.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.34.0",
    "@vueuse/core": "^11.0.0",
    "3d-force-graph": "^1.80.0",
    "axios": "^1.18.1",
    "d3-force-3d": "^3.0.6",
    "dompurify": "^3.4.11",
    "force-graph": "^1.51.4",
    "lucide-vue-next": "^0.453.0",
    "pinia": "^2.2.0",
    "pinia-plugin-persistedstate": "^3.2.0",
    "plancia": "^0.3.0",
    "reka-ui": "^2.0.0",
    "vue": "^3.5.0",
    "vue-i18n": "^11.4.5",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.2.3",
    "@playwright/test": "1.59.1",
    "@tailwindcss/forms": "^0.5.0",
    "@tailwindcss/typography": "^0.5.0",
    "@types/dompurify": "^3.0.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.0",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.10.0",
    "eslint-plugin-vue": "^9.27.0",
    "happy-dom": "20.9.0",
    "msw": "^2.4.0",
    "playwright": "1.59.1",
    "postcss": "^8.4.0",
    "prettier": "^3.3.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.5.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.5"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
