# The settings of the gosidian presets. ./init.sh copies this file to .env
# and fills the keys and tokens at the end; the models are yours to choose.
# Keep each comment on a line of its own: after an empty value, Compose
# would read it as the value.

# --- gosidian ---------------------------------------------------------
# 0.0.0.0 to reach it on the network; by default only this host.
GOSIDIAN_BIND=127.0.0.1
GOSIDIAN_PORT=8080
# The zone of the times written into notes, e.g. Europe/Rome.
TZ=UTC

# --- rag: the models ----------------------------------------------------
# Two OpenAI-compatible endpoints, up to /v1: the model that answers and
# describes images, and the one of the embeddings. They may be the same
# server. No default: pick what your hardware runs. Some examples:
#
#   CPU only, small models with Ollama on the host:
#     LLM_URL=http://host.docker.internal:11434/v1   LLM_MODEL=gemma3:4b
#     EMBED_URL=http://host.docker.internal:11434/v1 EMBED_MODEL=embeddinggemma:300m EMBED_DIMS=768
#
#   A GPU of 16 GB, the configuration of docs/rag-benchmarks.md: gemma4:12b
#   for the answers, Qwen3-Embedding-8B cut to 2048 numbers:
#     LLM_MODEL=gemma4:12b
#     EMBED_MODEL=qwen3-embedding:8b EMBED_DIMS=4096 EMBED_DIMENSIONS=2048
#
#   OpenRouter: LLM_URL=https://openrouter.ai/api/v1 LLM_API_KEY=sk-or-…
#
# A model's prefixes matter (docs/rag-benchmarks.md). Quote them with single
# quotes, which keep the trailing space and a \n as written. EmbeddingGemma:
#   EMBED_QUERY_PREFIX='task: search result | query: '
#   EMBED_DOCUMENT_TEMPLATE='title: {title} | text: {text}'
# Qwen3-Embedding:
#   EMBED_QUERY_PREFIX='Instruct: Given a web search query, retrieve relevant passages that answer the query\nQuery: '
LLM_URL=
LLM_MODEL=
# Empty for an endpoint without a key.
LLM_API_KEY=
EMBED_URL=
EMBED_MODEL=
# The size of the model's vectors, and the size to cut them to (0: whole).
EMBED_DIMS=
EMBED_DIMENSIONS=0
EMBED_QUERY_PREFIX=
EMBED_DOCUMENT_TEMPLATE=
EMBED_API_KEY=

# --- rag: the plugins ---------------------------------------------------
CHAT_BIND=127.0.0.1
CHAT_PORT=8095
# Where the browsers of who chats reach the bots.
CHAT_PUBLIC_URL=http://localhost:8095
DOCLING_MEMORY=6g
IMAGES_MEMORY=4g

# --- keys and tokens: init.sh writes them -------------------------------
GOSIDIAN_SECRETS_KEY=
DOCLING_TOKEN=
IMAGES_TOKEN=
CHAT_TOKEN=
DATABASE_TOKEN=
QDRANT_API_KEY=
STORAGE_TOKEN=
