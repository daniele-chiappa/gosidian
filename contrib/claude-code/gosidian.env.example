# Copy to .claude/gosidian.env in your checkout (and add that path to
# .gitignore: it holds a bearer token) or to ~/.config/gosidian/hook.env.
# Environment variables with the same names take precedence.

# MCP base URL: the URL you configured in the client, minus any trailing /sse.
GOSIDIAN_URL=https://vault.example.com/mcp

# A token with write scope. Prefer a self-service token in "inherit" mode
# (Settings → My MCP tokens): it follows your account's access as it changes.
GOSIDIAN_TOKEN=gsp_replace_me

# The vault project (top-level folder) this checkout works on.
GOSIDIAN_PROJECT=myproject

# Optional knobs
#GOSIDIAN_HOOK_FOCUS_BYTES=6000   # cap of the hot.md excerpt injected at SessionStart
#GOSIDIAN_HOOK_LOG_ENTRY=0        # 1 = also append a one-line pointer to <project>/log.md at SessionEnd
#GOSIDIAN_HOOK_STOP_LOG=0         # 1 = append the last assistant message to the session note at every turn
